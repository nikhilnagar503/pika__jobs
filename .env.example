# Names only. Do not put real secrets in source control.

# file (local persistence) or supabase (requires the variables below and applied migrations)
PIKAJOBS_DATA_MODE=file

# Required when the local file store signs cookies. Generate a long random string.
PIKAJOBS_SESSION_SECRET=

# One-time admin bootstrap allowlist. The account must still verify through Supabase Auth.
PIKAJOBS_ADMIN_EMAIL=nagarn603@gmail.com

# Public site URL used for magic-link redirects (no NEXT_PUBLIC_ needed).
APP_URL=http://localhost:3000

# Supabase Auth and Postgres. Copy values from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# In Supabase → Authentication → URL configuration, allow:
# http://localhost:3000/auth/callback
# https://pikajobs.vercel.app/auth/callback
# Enable the Email provider for magic-link sign-in.

# Payments stay off until every value below is set and the flag is true.
PIKAJOBS_PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Bearer secret for POST /api/internal/tasks/run. Required before the worker route will run.
PIKAJOBS_TASK_SECRET=

# Set true only after a source permission basis is recorded. Default collectors use fixtures.
PIKAJOBS_SOURCE_FETCH=false
