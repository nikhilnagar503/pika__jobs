{
  "name": "pikajobs",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=@pikajobs/frontend",
    "dev:backend": "npm run dev --workspace=@pikajobs/backend",
    "build": "npm run build --workspace=@pikajobs/frontend",
    "start:backend": "npm run start --workspace=@pikajobs/backend",
    "typecheck": "npm run typecheck --workspace=@pikajobs/backend && npm run typecheck --workspace=@pikajobs/frontend",
    "test": "vitest run",
    "worker": "tsx workers/src/index.ts"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
