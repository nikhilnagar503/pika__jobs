{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pikajobs.local/contracts/job-batch.schema.json",
  "title": "Pikajobs job intake batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "client_reference",
        "source_id",
        "source_url",
        "company_name",
        "role_title",
        "opportunity_kind",
        "work_mode",
        "summary",
        "application",
        "evidence",
        "collected_at"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "client_reference": { "type": "string", "minLength": 1, "maxLength": 120 },
        "source_id": { "type": "string", "format": "uuid" },
        "source_url": { "type": "string", "minLength": 1 },
        "source_job_id": { "type": ["string", "null"] },
        "company_name": { "type": "string", "minLength": 1 },
        "role_title": { "type": "string", "minLength": 1 },
        "opportunity_kind": {
          "enum": ["job", "internship", "apprenticeship", "freelance", "fellowship"]
        },
        "work_mode": { "enum": ["remote", "hybrid", "on_site", "field", "not_stated"] },
        "location_label": { "type": "string" },
        "location_unknown": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
        "application": {
          "type": "object",
          "required": ["method"],
          "properties": {
            "method": { "enum": ["url", "email", "both"] },
            "url": { "type": "string" },
            "email": { "type": "string" },
            "subject": { "type": "string" }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_url", "fetched_at", "excerpt"],
            "properties": {
              "source_url": { "type": "string" },
              "fetched_at": { "type": "string" },
              "excerpt": { "type": "string" }
            }
          }
        },
        "collected_at": { "type": "string" },
        "source_published_at": { "type": ["string", "null"] },
        "eligible_countries": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "role_family": { "type": "string" },
        "sector": { "type": "string" }
      }
    }
  }
}
